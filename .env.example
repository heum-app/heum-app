# ============================
# Server
# ============================
# localhost를 사용하면 iOS/Android 모두 자동 처리됩니다.
# - iOS 시뮬레이터: localhost 그대로 사용
# - Android 에뮬레이터: 자동으로 10.0.2.2로 변환
# - 실기기: PC의 실제 IP 주소를 입력하세요 (예: http://192.168.0.10:8100)
# - 배포 환경: 실제 서버 URL을 입력하세요
SERVER_URL=http://localhost:8100

# ============================
# KAKAO
# ============================
KAKAO_REST_API_KEY=
KAKAO_JS_KEY=
KAKAO_NATIVE_APP_KEY=

# ============================
# NAVER
# ============================
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ============================
# GOOGLE
# ============================
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
